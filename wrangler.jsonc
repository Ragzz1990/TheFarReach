{
  "name": "thefarreach",
  "main": "worker.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "BRIDGE_SESSIONS", "class_name": "BridgeSession" }]
  },
  "exports": {
    "BridgeSession": { "type": "durable-object", "storage": "sqlite" }
  }
}
